+
+package syncservice
+
+import (
+	"context"
+	"slices"
+	"testing"
+
+	"github.com/ProtonMail/gluon/async"
+	"github.com/ProtonMail/go-proton-api"
+	"github.com/ProtonMail/proton-bridge/v3/internal/network"
+	"github.com/bradenaw/juniper/xslices"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/mock/gomock"
+)
+
+// oldestFirstTestMessages returns messages in API order (descending ID). The IDs
+// deliberately do not follow the dates, as with imported mail.
+func oldestFirstTestMessages() []proton.MessageMetadata {
+	times := []int64{40, 10, 90, 20, 70, 30, 100, 50, 60, 80, 10, 5}
+	msgs := make([]proton.MessageMetadata, len(times))
+
+	for i, time := range times {
+		msgs[len(times)-1-i] = proton.MessageMetadata{ID: testMsgID(10 + i), Time: time, Size: 100}
+	}
+
+	return msgs
+}
+
+// expectDescMetadataPages emulates the API's Desc/EndID cursor: the EndID message is returned first again.
+func expectDescMetadataPages(tj *tjob, msgs []proton.MessageMetadata) {
+	tj.client.EXPECT().GetMessageMetadataPage(gomock.Any(), gomock.Eq(0), gomock.Any(), gomock.Any()).DoAndReturn(
+		func(_ context.Context, _, pageSize int, filter proton.MessageFilter) ([]proton.MessageMetadata, error) {
+			if !filter.Desc {
+				panic("oldest-first sync must use the upstream Desc cursor")
+			}
+
+			start := 0
+			if filter.EndID != "" {
+				start = slices.IndexFunc(msgs, func(m proton.MessageMetadata) bool { return m.ID == filter.EndID })
+				if start < 0 {
+					return nil, nil
+				}
+			}
+
+			return slices.Clone(msgs[start:min(start+pageSize, len(msgs))]), nil
+		},
+	).AnyTimes()
+}
+
+func sortedOldestFirst(msgs []proton.MessageMetadata) []string {
+	sorted := slices.Clone(msgs)
+	slices.SortFunc(sorted, func(a, b proton.MessageMetadata) int {
+		return oldestFirstKey{Time: a.Time, ID: a.ID}.compare(oldestFirstKey{Time: b.Time, ID: b.ID})
+	})
+
+	return xslices.Map(sorted, func(m proton.MessageMetadata) string { return m.ID })
+}
+
+func TestOldestFirst_FeedsPipelineByDateAndStoresCursor(t *testing.T) {
+	t.Setenv(OldestFirstEnvVar, "1")
+
+	mockCtrl := gomock.NewController(t)
+	tj := newTestJob(context.Background(), mockCtrl, "u", getTestLabels())
+	tj.state.EXPECT().GetSyncStatus(gomock.Any()).Return(Status{}, nil)
+	tj.syncReporter.EXPECT().OnProgress(gomock.Any(), gomock.Any()).AnyTimes()
+
+	msgs := oldestFirstTestMessages()
+	expectDescMetadataPages(&tj, msgs)
+
+	var cursors []string
+
+	tj.state.EXPECT().SetLastMessageID(gomock.Any(), gomock.Any(), gomock.Any()).DoAndReturn(
+		func(_ context.Context, cursor string, _ int64) error {
+			cursors = append(cursors, cursor)
+			return nil
+		},
+	).AnyTimes()
+
+	input := NewChannelConsumerProducer[*Job]()
+	output := NewChannelConsumerProducer[DownloadRequest]()
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	metadata := NewMetadataStage(input, output, TestMaxDownloadMem, &async.NoopPanicHandler{})
+
+	go func() {
+		metadata.run(ctx, TestMetadataPageSize, 4, &network.NoCoolDown{})
+	}()
+
+	require.NoError(t, input.Produce(ctx, tj.job))
+
+	var (
+		ids      []string
+		lastIDs  []string
+		received int
+	)
+
+	for received < len(msgs) {
+		req, err := output.Consume(ctx)
+		require.NoError(t, err)
+		require.LessOrEqual(t, len(req.ids), 4)
+
+		ids = append(ids, req.ids...)
+		lastIDs = append(lastIDs, req.ids[len(req.ids)-1])
+		received += len(req.ids)
+
+		req.onFinished(ctx)
+	}
+
+	require.NoError(t, tj.job.waitAndClose(ctx))
+
+	expected := sortedOldestFirst(msgs)
+	require.Equal(t, expected, ids)
+
+	require.Len(t, cursors, len(lastIDs))
+
+	byID := make(map[string]proton.MessageMetadata, len(msgs))
+	for _, m := range msgs {
+		byID[m.ID] = m
+	}
+
+	newest := byID[expected[len(expected)-1]]
+
+	for i, encoded := range cursors {
+		cursor, err := decodeOldestFirstCursor(encoded)
+		require.NoError(t, err)
+		require.Equal(t, oldestFirstKey{Time: byID[lastIDs[i]].Time, ID: lastIDs[i]}, cursor.Last)
+		require.Equal(t, oldestFirstKey{Time: newest.Time, ID: newest.ID}, cursor.Snapshot)
+	}
+}
+
+func TestOldestFirst_ResumeAfterDeletedCursorMessageAndSkipsNewerMail(t *testing.T) {
+	t.Setenv(OldestFirstEnvVar, "1")
+
+	mockCtrl := gomock.NewController(t)
+	ctx := context.Background()
+	tj := newTestJob(ctx, mockCtrl, "u", getTestLabels())
+
+	// The last synced message (time 35) was deleted; mail with time 100 arrived after the sync started.
+	cursor := oldestFirstCursor{
+		Snapshot: oldestFirstKey{Time: 90, ID: testMsgID(12)},
+		Last:     oldestFirstKey{Time: 35, ID: "deleted"},
+	}
+	tj.state.EXPECT().GetSyncStatus(gomock.Any()).Return(Status{LastSyncedMessageID: cursor.encode()}, nil)
+
+	expectDescMetadataPages(&tj, oldestFirstTestMessages())
+
+	iter, err := newMetadataIterator(ctx, tj.job, TestMetadataPageSize, &network.NoCoolDown{})
+	require.NoError(t, err)
+
+	var ids []string
+
+	for {
+		req, hasMore, err := iter.Next(TestMaxDownloadMem, TestMetadataPageSize, TestMaxMessages)
+		require.NoError(t, err)
+
+		ids = append(ids, req.ids...)
+
+		if !hasMore {
+			break
+		}
+	}
+
+	byID := make(map[string]int64)
+	for _, m := range oldestFirstTestMessages() {
+		byID[m.ID] = m.Time
+	}
+
+	require.Equal(t, []int64{40, 50, 60, 70, 80, 90}, xslices.Map(ids, func(id string) int64 { return byID[id] }))
+}
+
+func TestOldestFirst_RejectsUpstreamCursor(t *testing.T) {
+	t.Setenv(OldestFirstEnvVar, "1")
+
+	mockCtrl := gomock.NewController(t)
+	ctx := context.Background()
+	tj := newTestJob(ctx, mockCtrl, "u", getTestLabels())
+	tj.state.EXPECT().GetSyncStatus(gomock.Any()).Return(Status{LastSyncedMessageID: "foo"}, nil)
+
+	_, err := newMetadataIterator(ctx, tj.job, TestMetadataPageSize, &network.NoCoolDown{})
+	require.ErrorIs(t, err, errOldestFirstCursorMismatch)
+}
+
+func TestOldestFirst_DefaultModeRejectsOldestFirstCursor(t *testing.T) {
+	t.Setenv(OldestFirstEnvVar, "")
+
+	mockCtrl := gomock.NewController(t)
+	ctx := context.Background()
+	tj := newTestJob(ctx, mockCtrl, "u", getTestLabels())
+	tj.state.EXPECT().GetSyncStatus(gomock.Any()).Return(Status{
+		LastSyncedMessageID: oldestFirstCursor{Last: oldestFirstKey{Time: 1, ID: "foo"}}.encode(),
+	}, nil)
+
+	_, err := newMetadataIterator(ctx, tj.job, TestMetadataPageSize, &network.NoCoolDown{})
+	require.ErrorIs(t, err, errOldestFirstCursorMismatch)
+}
+
+func TestOldestFirst_DisabledByDefault(t *testing.T) {
+	t.Setenv(OldestFirstEnvVar, "")
+
+	mockCtrl := gomock.NewController(t)
+	ctx := context.Background()
+	tj := newTestJob(ctx, mockCtrl, "u", getTestLabels())
+	tj.state.EXPECT().GetSyncStatus(gomock.Any()).Return(Status{LastSyncedMessageID: "foo"}, nil)
+
+	iter, err := newMetadataIterator(ctx, tj.job, TestMetadataPageSize, &network.NoCoolDown{})
+	require.NoError(t, err)
+	require.Nil(t, iter.oldestFirst)
+	require.Nil(t, tj.job.syncCursor)
+	require.Equal(t, "foo", iter.lastMessageID)
+}
