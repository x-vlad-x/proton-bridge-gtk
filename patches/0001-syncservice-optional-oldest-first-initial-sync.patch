+
+// Optional oldest-first initial sync, added by proton-bridge-gtk.
+//
+// Gluon assigns UIDs in the order messages are applied. The upstream iterator
+// walks the API from the newest message to the oldest, so UID 1 is the newest
+// message. Some IMAP clients (e.g. Geary) assume a higher UID means newer mail.
+// With BRIDGE_GTK_SYNC_OLDEST_FIRST=1 the iterator first collects the complete
+// metadata list (the same Desc/EndID paging as upstream), sorts it by
+// (Time, ID) ascending and feeds it down the unchanged pipeline, so UIDs grow
+// with the message date. Without the variable, behaviour is unchanged.
+
+package syncservice
+
+import (
+	"cmp"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"slices"
+	"strings"
+
+	"github.com/ProtonMail/go-proton-api"
+	"github.com/ProtonMail/proton-bridge/v3/internal/network"
+)
+
+const (
+	OldestFirstEnvVar = "BRIDGE_GTK_SYNC_OLDEST_FIRST"
+
+	oldestFirstCursorPrefix = "oldest-first:v1:"
+)
+
+var errOldestFirstCursorMismatch = errors.New("sync cursor was written in a different message order mode; a full resync (repair) is required")
+
+func oldestFirstEnabled() bool {
+	return os.Getenv(OldestFirstEnvVar) == "1"
+}
+
+// oldestFirstKey orders messages by date, with the ID as a stable tie-breaker.
+type oldestFirstKey struct {
+	Time int64  `json:"time"`
+	ID   string `json:"id"`
+}
+
+func (k oldestFirstKey) compare(other oldestFirstKey) int {
+	if c := cmp.Compare(k.Time, other.Time); c != 0 {
+		return c
+	}
+
+	return strings.Compare(k.ID, other.ID)
+}
+
+// oldestFirstCursor is stored in the sync state's LastSyncedMessageID.
+// Snapshot is the newest message of the initial listing: messages created after
+// it are delivered by the event stream, as with the upstream iterator.
+type oldestFirstCursor struct {
+	Snapshot oldestFirstKey `json:"snapshot"`
+	Last     oldestFirstKey `json:"last"`
+}
+
+func (c oldestFirstCursor) encode() string {
+	data, err := json.Marshal(c)
+	if err != nil {
+		panic(err) // Plain structs of strings and integers always marshal.
+	}
+
+	return oldestFirstCursorPrefix + string(data)
+}
+
+func decodeOldestFirstCursor(value string) (oldestFirstCursor, error) {
+	var cursor oldestFirstCursor
+
+	if err := json.Unmarshal([]byte(strings.TrimPrefix(value, oldestFirstCursorPrefix)), &cursor); err != nil {
+		return oldestFirstCursor{}, fmt.Errorf("invalid oldest-first sync cursor: %w", err)
+	}
+
+	return cursor, nil
+}
+
+type oldestFirstState struct {
+	resume   *oldestFirstCursor
+	loaded   bool
+	snapshot oldestFirstKey
+	keys     map[string]oldestFirstKey
+	last     string
+}
+
+// withOldestFirst enables the oldest-first order on a new iterator when requested
+// and rejects a sync cursor that was written in the other mode.
+func withOldestFirst(iter *metadataIterator, lastSyncedMessageID string) (*metadataIterator, error) {
+	isOldestFirstCursor := strings.HasPrefix(lastSyncedMessageID, oldestFirstCursorPrefix)
+
+	if !oldestFirstEnabled() {
+		if isOldestFirstCursor {
+			return nil, errOldestFirstCursorMismatch
+		}
+
+		return iter, nil
+	}
+
+	state := &oldestFirstState{}
+
+	if lastSyncedMessageID != "" {
+		if !isOldestFirstCursor {
+			return nil, errOldestFirstCursorMismatch
+		}
+
+		cursor, err := decodeOldestFirstCursor(lastSyncedMessageID)
+		if err != nil {
+			return nil, err
+		}
+
+		state.resume = &cursor
+		state.last = lastSyncedMessageID
+	}
+
+	iter.oldestFirst = state
+	iter.stage.syncCursor = state.cursor
+
+	return iter, nil
+}
+
+// next returns all remaining metadata in oldest-first order on its first call and nothing afterwards.
+func (s *oldestFirstState) next(m *metadataIterator, metadataPageSize int) ([]proton.MessageMetadata, error) {
+	if s.loaded {
+		return nil, nil
+	}
+
+	all, err := s.fetchAll(m, metadataPageSize)
+	if err != nil {
+		return nil, err
+	}
+
+	keys := make(map[string]oldestFirstKey, len(all))
+	sizes := make(map[string]int, len(all))
+
+	for _, meta := range all {
+		keys[meta.ID] = oldestFirstKey{Time: meta.Time, ID: meta.ID}
+		sizes[meta.ID] = meta.Size
+	}
+
+	ordered := make([]oldestFirstKey, 0, len(keys))
+	for _, key := range keys {
+		ordered = append(ordered, key)
+	}
+
+	slices.SortFunc(ordered, oldestFirstKey.compare)
+
+	if s.resume != nil {
+		s.snapshot = s.resume.Snapshot
+		ordered = slices.DeleteFunc(ordered, func(k oldestFirstKey) bool {
+			return k.compare(s.resume.Last) <= 0 || k.compare(s.snapshot) > 0
+		})
+	} else if len(ordered) != 0 {
+		s.snapshot = ordered[len(ordered)-1]
+	}
+
+	// Keep only what the pipeline needs; the full metadata is not retained.
+	result := make([]proton.MessageMetadata, 0, len(ordered))
+	for _, key := range ordered {
+		result = append(result, proton.MessageMetadata{ID: key.ID, Time: key.Time, Size: sizes[key.ID]})
+	}
+
+	m.stage.log.Infof("Oldest-first sync: %v messages listed, %v remaining", len(keys), len(result))
+
+	s.keys = keys
+	s.loaded = true
+
+	return result, nil
+}
+
+// fetchAll pages through the metadata exactly like the upstream iterator.
+func (s *oldestFirstState) fetchAll(m *metadataIterator, metadataPageSize int) ([]proton.MessageMetadata, error) {
+	var (
+		all    []proton.MessageMetadata
+		lastID string
+	)
+
+	for {
+		if err := m.stage.ctx.Err(); err != nil {
+			return nil, err
+		}
+
+		page, err := network.RetryWithClient(m.stage.ctx, m.client, func(ctx context.Context, c APIClient) ([]proton.MessageMetadata, error) {
+			return c.GetMessageMetadataPage(ctx, 0, metadataPageSize, proton.MessageFilter{
+				EndID: lastID,
+				Desc:  true,
+			})
+		})
+		if err != nil {
+			m.stage.log.WithError(err).Errorf("Failed to download message metadata with lastMessageID=%v", lastID)
+			return nil, err
+		}
+
+		// The EndID message is returned again as the first result.
+		if lastID != "" && len(page) != 0 && page[0].ID == lastID {
+			page = page[1:]
+		}
+
+		if len(page) == 0 {
+			return all, nil
+		}
+
+		all = append(all, page...)
+		lastID = page[len(page)-1].ID
+	}
+}
+
+// cursor converts the last message ID of a finished batch into the stored sync cursor.
+func (s *oldestFirstState) cursor(messageID string) string {
+	key, ok := s.keys[messageID]
+	if !ok {
+		// Should not happen: every batch comes from the listing. Keeping the previous
+		// cursor only causes a few messages to be applied again after a restart.
+		return s.last
+	}
+
+	s.last = oldestFirstCursor{Snapshot: s.snapshot, Last: key}.encode()
+
+	return s.last
+}
