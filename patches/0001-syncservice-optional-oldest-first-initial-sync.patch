+package imapservice
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/ProtonMail/go-proton-api"
+)
+
+func TestDateOrderedUnknownDate(t *testing.T) {
+	t.Setenv("BRIDGE_GTK_SYNC_OLDEST_FIRST", "1")
+	got := toIMAPMessage(proton.MessageMetadata{Time: 0}).Date
+	if !got.Equal(time.Unix(0, 0)) {
+		t.Fatalf("unknown date: %v", got)
+	}
+	t.Setenv("BRIDGE_GTK_SYNC_OLDEST_FIRST", "")
+	if time.Since(toIMAPMessage(proton.MessageMetadata{Time: 0}).Date) > time.Second {
+		t.Fatal("upstream fallback changed")
+	}
+}
+
+func TestDateOrderedDefersLiveMessageEvents(t *testing.T) {
+	t.Setenv("BRIDGE_GTK_SYNC_OLDEST_FIRST", "1")
+	// No service is needed: the event is replayed after initial sync.
+	h := syncMessageEventHandler{}
+	err := h.HandleMessageEvents(context.Background(), []proton.MessageEvent{{EventItem: proton.EventItem{Action: proton.EventCreate}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
